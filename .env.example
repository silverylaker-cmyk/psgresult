# 서버(npm run server) 를 쓸 때만 필요합니다. 브라우저 음성만 쓰면 이 파일은 필요 없습니다.

# TTS 공급자: openai | edge | none
TTS_PROVIDER=openai

# OpenAI TTS (유료). https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova

# Edge TTS (무료·비공식, `npm i msedge-tts` 후 TTS_PROVIDER=edge)
EDGE_TTS_VOICE=ko-KR-SunHiNeural

# 서버 포트
PORT=3123

# Remotion 이 쓸 Chrome/Chromium 경로 (비워 두면 자동 다운로드)
REMOTION_BROWSER_EXECUTABLE=
