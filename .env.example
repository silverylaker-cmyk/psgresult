# ── 서버(npm run server / Docker) 설정 ─────────────────────────────────────
# 브라우저 음성만 쓰면 이 파일은 필요 없습니다.

# TTS 공급자: google | openai | edge | none  (비우면 키가 있는 공급자를 자동 선택)
TTS_PROVIDER=google

# Google Cloud Text-to-Speech (권장 · 한국어 품질 가장 좋음)
#   콘솔에서 "Cloud Text-to-Speech API" 사용 설정 → 사용자 인증 정보 → API 키 생성
#   서버용 키는 "API 제한 = Cloud Text-to-Speech API" 만 걸면 됩니다.
GOOGLE_TTS_API_KEY=
# ko-KR-Chirp3-HD-Aoede | ko-KR-Chirp3-HD-Kore | ko-KR-Chirp3-HD-Charon(남) | ko-KR-Neural2-A | ko-KR-Wavenet-A …
GOOGLE_TTS_VOICE=ko-KR-Chirp3-HD-Aoede
GOOGLE_TTS_RATE=1.0

# OpenAI TTS (유료). https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova

# Edge TTS (무료·비공식, `npm i msedge-tts` 후 TTS_PROVIDER=edge)
EDGE_TTS_VOICE=ko-KR-SunHiNeural

# 이 서버의 외부 주소. 환자용 MP4 링크가 이 주소로 만들어집니다 (예: https://psg.example.com)
PUBLIC_URL=

# 다른 주소(GitHub Pages 등)의 화면에서 이 서버를 부를 때 허용할 origin. 기본 * (모두)
CORS_ORIGIN=*

# 서버 포트
PORT=3123

# Remotion 이 쓸 Chrome/Chromium 경로 (비워 두면 자동 다운로드)
REMOTION_BROWSER_EXECUTABLE=

# ── 정적 빌드(npm run build / GitHub Pages) 설정 ───────────────────────────
# 서버 없이 브라우저에서 Google TTS 를 직접 부를 때 쓰는 키. 빌드 결과(JS)에 그대로 들어가므로
# 반드시 "HTTP 리퍼러 제한 = 사이트 주소" + "API 제한 = Cloud Text-to-Speech API" + 일일 한도를 설정하세요.
# GitHub Pages 에서는 저장소 Settings → Secrets → GOOGLE_TTS_KEY 에 넣으면 워크플로가 빌드에 주입합니다.
VITE_GOOGLE_TTS_KEY=
VITE_GOOGLE_TTS_VOICE=ko-KR-Chirp3-HD-Aoede
# 정적 사이트가 기본으로 연결할 서버 주소 (MP4 저장용, 선택)
VITE_SERVER_URL=
